# Copy this file to .env and fill in your values.
# .env is gitignored and must never be committed.

# Remote server
REMOTE_HOST=your-vps-ip-or-hostname
REMOTE_USER=root
SSH_KEY=/home/youruser/.ssh/your_key

# TURN REST credentials. This shared secret must match coturn's
# static-auth-secret and is stored only in the backend service environment.
TURN_SHARED_SECRET=replace-with-openssl-rand-hex-32
TURN_REALM=turn.your-domain.com
TURN_TTL_SECONDS=600

# Optional explicit TURN URL override returned by /api/turn-credentials.
# Leave empty to default to turns:<TURN_REALM>:443?transport=tcp.
# Example: TURN_URLS=turns:turn.your-domain.com:443?transport=tcp
TURN_URLS=

# Allowed WebSocket origins (comma-separated)
CORS_ORIGIN=https://your-domain.com

# Optional bulletin storage/runtime overrides
BULLETIN_STORE_PATH=/var/lib/messenger-backend/bulletins.json
BULLETIN_TTL_MINUTES=4320
